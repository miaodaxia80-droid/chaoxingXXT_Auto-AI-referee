    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "^1.62.1",
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^24.1.0",
    "@typescript-eslint/parser": "8.46.4",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.32.0",
    "eslint-plugin-vue": "^10.3.0",
    "globals": "16.4.0",
    "typescript": "^5.8.3",
