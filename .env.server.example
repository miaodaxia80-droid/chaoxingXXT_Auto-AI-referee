# Copy to .env.server and replace the examples with values for this deployment.
# Include every browser origin used to access the console.
CX_ALLOWED_ORIGINS=["https://console.example.com"]

# For direct LAN/Tailscale access, replace these examples with actual client CIDRs.
# A public reverse-proxy/tunnel deployment may use [] only when the host firewall
# blocks direct backend access and the proxy is the sole public entry.
CX_ALLOWED_CLIENT_NETWORKS=["192.0.2.0/24","100.64.0.0/10"]

# Set false to support direct HTTP on a trusted LAN. HTTPS requests still receive
# Secure cookies. Prefer HTTPS for all public access.
CX_SECURE_COOKIES_OVERRIDE=false
CX_WORKER_MAX_WORKERS=2

# Optional egress proxy. Leave blank to connect directly.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=127.0.0.1,localhost
